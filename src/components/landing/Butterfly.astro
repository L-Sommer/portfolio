---
// Easter egg: hovering (or tapping) the top-left leaves releases a small sage-and-gold butterfly
// that lands on the "L" of the name, flaps, rests, then drifts off to the right.
// The hit zone covers the leaf cluster; the butterfly itself never takes pointer events.
const fore = 'M-1,-2 C-5,-17 -19,-25 -27,-18 C-31,-13 -27,-5 -18,-1.5 C-12,0.5 -6,0.8 -1,1 Z';
const hind = 'M-1,2 C-9,2 -20,6 -20,13.5 C-20,20 -12,21 -7,15.5 C-4,12 -2,8 -1,5 Z';
const wing = (id: string) => `
  <path d="${fore}" fill="url(#bf-fore-${id})" stroke="#c3a35a" stroke-width=".9" stroke-linejoin="round"/>
  <path d="${hind}" fill="url(#bf-hind-${id})" stroke="#c3a35a" stroke-width=".8" stroke-linejoin="round"/>
  <path d="M-1.5,-1 C-8,-6 -15,-12 -22,-16 M-1.5,-0.5 C-8,-3 -15,-5 -24,-8 M-1.5,0 C-7,-0.5 -12,-1 -17,-1.5 M-1.5,3 C-7,5 -12,8 -16,13" fill="none" stroke="#efe6c8" stroke-width=".55" stroke-opacity=".7"/>
  <circle cx="-22" cy="-15" r="1.3" fill="#c3a35a"/><circle cx="-25.2" cy="-11" r=".9" fill="#c3a35a"/><circle cx="-15" cy="15" r="1" fill="#c3a35a"/>`;
---

<div class="bf-zone" aria-hidden="true"></div>
<template id="bf-template">
  <div class="bf" aria-hidden="true">
    <svg viewBox="-30 -26 60 50">
      <defs>
        <linearGradient id="bf-fore-a" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#7d876d" /><stop offset=".45" stop-color="#959f86" /><stop offset="1" stop-color="#bfc6b2" /></linearGradient>
        <linearGradient id="bf-hind-a" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#838d73" /><stop offset="1" stop-color="#c5c9b7" /></linearGradient>
      </defs>
      <g class="bf-wing" data-side="-1" set:html={wing('a')} />
      <g class="bf-wing" data-side="1" set:html={`<g transform="scale(-1 1)">${wing('a')}</g>`} />
      <path d="M-.4,-10 C-2,-15 -4.5,-18.5 -6.5,-20.5 M.4,-10 C2,-15 4.5,-18.5 6.5,-20.5" fill="none" stroke="#a98a45" stroke-width=".7" stroke-linecap="round" />
      <circle cx="-6.6" cy="-20.6" r=".9" fill="#c3a35a" /><circle cx="6.6" cy="-20.6" r=".9" fill="#c3a35a" />
      <ellipse cx="0" cy="1.5" rx="1.5" ry="9" fill="#4a5340" />
      <circle cx="0" cy="-8.6" r="1.9" fill="#4a5340" />
    </svg>
  </div>
</template>

<script>
  import { initButterfly } from '../../lib/butterfly';
  initButterfly();
</script>
