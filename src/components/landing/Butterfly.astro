---
// Easter egg: hovering (or tapping) the top-left leaves releases a small butterfly that lands on
// the left end of the "L", flaps, rests, then drifts off to the right.
// Line-drawing style: pale wings with a sage band along the outer edges, a fine olive outline,
// slender body and gold-tipped antennae. Only the top-left leaves and stems trigger it (see
// landing.css); the butterfly itself never takes pointer events. Left wings are drawn here; the
// right ones are mirrored.

// Forewing: body → leading edge → pointed apex → outer margin → back to the body.
const foreOuter = 'M-1.2,-2 C-6,-12 -16,-20.5 -26,-21.2 C-28.6,-21.3 -29.6,-19.2 -28.2,-16.6 C-25.6,-11.2 -22.2,-5.4 -19.2,-1.2 C-13.2,0.5 -6.4,1.2 -1.2,1.5 Z';
const foreInner = 'M-2.3,-1.7 C-7,-10.4 -14.8,-16.8 -22.4,-17.9 C-23.6,-15.2 -21.6,-9.2 -17.6,-3.6 C-12.2,-1.8 -6.6,-0.5 -2.3,0.3 Z';
// Hindwing: a rounded lobe with a gently scalloped lower edge.
const hindOuter = 'M-1.2,2.2 C-6,2.1 -13,2.6 -17.2,4.6 C-20.6,6.6 -20.2,10.8 -18,13.4 C-16.8,15 -15.6,15.4 -14.6,16.6 C-12.6,18.8 -9.4,19.6 -7.4,18.4 C-4.4,16.6 -2.4,11 -1.2,6 Z';
const hindInner = 'M-2.1,3 C-6,3.1 -11,3.7 -14.1,5.5 C-16.3,7.1 -15.7,10.6 -13.7,12.9 C-11.7,15.1 -9.1,15.6 -7.7,14.6 C-5.1,12.6 -3.1,8.6 -2.1,5.6 Z';

const wing = `
  <path d="${foreOuter}" fill="url(#bf-band)"/>
  <path d="${foreInner}" fill="url(#bf-pale)"/>
  <path d="${hindOuter}" fill="url(#bf-band)"/>
  <path d="${hindInner}" fill="url(#bf-pale)"/>
  <path d="${foreOuter}" fill="none" stroke="#4a5340" stroke-width="1" stroke-linejoin="round"/>
  <path d="${hindOuter}" fill="none" stroke="#4a5340" stroke-width="1" stroke-linejoin="round"/>
  <path d="${foreInner}" fill="none" stroke="#4a5340" stroke-width=".5" stroke-opacity=".55"/>
  <path d="${hindInner}" fill="none" stroke="#4a5340" stroke-width=".5" stroke-opacity=".55"/>
  <circle cx="-25.4" cy="-18.8" r=".9" fill="#c3a35a"/><circle cx="-23.6" cy="-13.6" r=".7" fill="#c3a35a"/>`;
---

<template id="bf-template">
  <div class="bf" aria-hidden="true">
    <svg viewBox="-32 -26 64 50">
      <defs>
        <linearGradient id="bf-band" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#a3ab95" /><stop offset=".5" stop-color="#8e977f" /><stop offset="1" stop-color="#7a846b" /></linearGradient>
        <radialGradient id="bf-pale" cx="1" cy=".6" r="1.1"><stop offset="0" stop-color="#e3e6d8" /><stop offset=".55" stop-color="#f4f2ea" /><stop offset="1" stop-color="#faf8f2" /></radialGradient>
      </defs>
      <g class="bf-wing" data-side="-1" set:html={wing} />
      <g class="bf-wing" data-side="1" set:html={`<g transform="scale(-1 1)">${wing}</g>`} />
      <path d="M-.4,-9.4 C-1.6,-13.6 -3.4,-16.4 -5.6,-18.2 M.4,-9.4 C1.6,-13.6 3.4,-16.4 5.6,-18.2" fill="none" stroke="#4a5340" stroke-width=".6" stroke-linecap="round" />
      <circle cx="-5.7" cy="-18.3" r=".85" fill="#c3a35a" /><circle cx="5.7" cy="-18.3" r=".85" fill="#c3a35a" />
      <ellipse cx="0" cy="1" rx="1.1" ry="8.5" fill="#4a5340" />
      <circle cx="0" cy="-8" r="1.6" fill="#4a5340" />
    </svg>
  </div>
</template>

<script>
  import { initButterfly } from '../../lib/butterfly';
  initButterfly();
</script>
