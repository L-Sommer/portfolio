---
// Placeholder for a landing sub-page that hasn't been written yet, in the landing page style.
import LandingLayout from '../../layouts/LandingLayout.astro';
import NavItem from './NavItem.astro';
import Sprig from '../Sprig.astro';
import { owner } from '../../data/landing';

interface Props {
  heading: string;
}
const { heading } = Astro.props;
---

<LandingLayout title={`${heading} | ${owner.name}`}>
  <main class="lp lp-sub">
    <p class="lp-kicker"><a href="/">{owner.name}</a></p>
    <h1 class="lp-title">{heading}</h1>
    <div class="lp-divider" aria-hidden="true"><Sprig /></div>
    <p class="lp-note">Coming soon</p>
    <NavItem label="Back home" href="/">
      <Sprig slot="icon" class="nav-icon" />
    </NavItem>
  </main>
</LandingLayout>

<script>
  import { bindNavCircles } from '../../lib/nav-circles';
  bindNavCircles();
</script>
