---
// Portfolio shell: header (desktop nav with Advanced dropdown, mobile overlay menu), content,
// footer, and the Past Works lightbox. Replicates the Wix site minus the "Built on Wix" bar.
import Base from './Base.astro';
import { portfolioNav } from '../data/nav';
import '../styles/portfolio.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href === path ? 'page' : undefined);
const chevron = `<svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

<Base title={title}>
  <div class="site">
    <header class="hdr">
      <a class="logo" href="/portfolio" aria-label="Portfolio home">LS</a>
      <nav aria-label="Portfolio">
        <ul class="nav">
          {
            portfolioNav.map((item) => (
              <li class={item.children ? 'has-sub' : undefined}>
                <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
                {item.children && (
                  <ul class="sub">
                    {item.children.map((c) => (
                      <li><a href={c.href} aria-current={current(c.href)}>{c.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <button class="menu-btn" type="button" aria-label="Menu" aria-controls="menu" aria-expanded="false">
        <svg viewBox="0 0 24 10" aria-hidden="true"><path d="M1 2h22M9 8h14" stroke="currentColor" stroke-width="1.2" /></svg>
      </button>
    </header>

    <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
      <button class="menu-close" type="button" aria-label="Close Menu">
        <svg viewBox="0 0 34 12" aria-hidden="true"><path d="M1 1l32 10M1 11L33 1" stroke="currentColor" stroke-width="1.2" /></svg>
      </button>
      <nav class="menu-card" aria-label="Portfolio">
        <ul>
          {
            portfolioNav.map((item, i) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
                {item.children && (
                  <>
                    <button class="sub-toggle" type="button" aria-label={`More ${item.label} pages`} aria-expanded="false" aria-controls={`m-sub-${i}`} set:html={chevron} />
                    <ul class="m-sub" id={`m-sub-${i}`}>
                      {item.children.map((c) => (
                        <li><a href={c.href} aria-current={current(c.href)}>{c.label}</a></li>
                      ))}
                    </ul>
                  </>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="menu-badge" href="/portfolio" aria-label="Portfolio home">LS</a>
    </div>

    <main>
      <slot />
    </main>
    <footer class="ftr"></footer>
  </div>

  <script>
    // Mobile menu
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
    const menu = document.getElementById('menu')!;
    const setMenu = (open: boolean) => {
      menu.hidden = !open;
      menu.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLElement>('.menu-close')?.focus();
      else btn.focus();
    };
    btn.addEventListener('click', () => setMenu(true));
    menu.querySelector('.menu-close')!.addEventListener('click', () => setMenu(false));
    menu.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
    menu.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((t) =>
      t.addEventListener('click', () => {
        const open = t.getAttribute('aria-expanded') !== 'true';
        t.setAttribute('aria-expanded', String(open));
        document.getElementById(t.getAttribute('aria-controls')!)!.classList.toggle('is-open', open);
      }),
    );

    // Lightbox: any button[data-lightbox] opens the matching <dialog> at its index.
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((trigger) => {
      const dialog = document.getElementById(`lb-${trigger.dataset.lightbox}`) as HTMLDialogElement | null;
      if (!dialog) return;
      const track = dialog.querySelector<HTMLElement>('.lb-track')!;
      const count = track.children.length;
      const go = (i: number) => {
        const n = ((i % count) + count) % count;
        dialog.dataset.index = String(n);
        track.style.transform = `translateX(${-100 * n}%)`;
        [...track.children].forEach((s, k) => s.setAttribute('aria-hidden', String(k !== n)));
      };
      const step = (d: number) => go(Number(dialog.dataset.index ?? 0) + d);
      if (!dialog.dataset.bound) {
        dialog.dataset.bound = '1';
        dialog.querySelector('.lb-prev')!.addEventListener('click', () => step(-1));
        dialog.querySelector('.lb-next')!.addEventListener('click', () => step(1));
        dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
        dialog.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') step(-1);
          if (e.key === 'ArrowRight') step(1);
        });
        let x0: number | null = null;
        dialog.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
        dialog.addEventListener('touchend', (e) => {
          if (x0 === null) return;
          const dx = e.changedTouches[0].clientX - x0;
          if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
          x0 = null;
        });
      }
      trigger.addEventListener('click', () => {
        track.style.transition = 'none';
        go(Number(trigger.dataset.index));
        dialog.showModal();
        requestAnimationFrame(() => (track.style.transition = ''));
      });
    });
  </script>
</Base>
