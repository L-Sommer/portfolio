---
// Landing page: name, sprig divider and the five navigation circles over animated artwork.
import LandingLayout from '../layouts/LandingLayout.astro';
import NavItem from '../components/landing/NavItem.astro';
import Sprig from '../components/Sprig.astro';
import { owner, links } from '../data/landing';
---

<LandingLayout title={owner.name} description={owner.description}>
  <main class="lp">
    <h1 class="lp-name">{owner.name}</h1>
    <div class="lp-divider" aria-hidden="true"><Sprig /></div>
    <nav aria-label="Main">
      <ul class="lp-nav">
        {links.map((l) => <li><NavItem {...l} /></li>)}
      </ul>
    </nav>
  </main>
</LandingLayout>

<script>
  import { bindNavCircles } from '../lib/nav-circles';
  bindNavCircles();
</script>
