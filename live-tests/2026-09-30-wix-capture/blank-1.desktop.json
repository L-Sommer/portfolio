    {
      "tag": "span",
      "text": "About Me",
      "box": {
        "x": 643,
        "y": 214,
        "w": 171,
        "h": 40
      },
      "font": "adobe-caslon-w01-smbd, serif",
      "size": "40px",
      "weight": "400",
      "style": "normal",
      "lineHeight": "44px",
